<section class="bk-section bk-announcement-bar{% if section.settings.tone == 'accent' %} bk-announcement-bar--accent{% endif %}">
  <div class="bk-wrap bk-announcement-bar__inner">
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}">
        {% if section.settings.icon != blank %}<span class="bk-announcement-icon">{{ section.settings.icon }}</span>{% endif %}
        <span>{{ section.settings.text }}</span>
      </a>
    {% else %}
      {% if section.settings.icon != blank %}<span class="bk-announcement-icon">{{ section.settings.icon }}</span>{% endif %}
      <span>{{ section.settings.text }}</span>
    {% endif %}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .bk-announcement-bar {
    background: #050505;
    color: #ffb900;
    text-align: center;
    padding: 10px 16px;
    border-bottom: 4px solid #050505;
    font-size: clamp(16px, 2vw, 24px);
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: .04em;
  }
  #shopify-section-{{ section.id }} .bk-announcement-bar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .bk-announcement-bar a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .bk-announcement-icon {
    display: inline-flex;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .bk-announcement-bar--accent {
    background: linear-gradient(90deg, #ffb900, #ffd050);
    color: #050505;
  }
</style>

{% schema %}
{"name":"BK Announcement Bar","tag":"section","settings":[{"type":"text","id":"text","label":"Announcement text","default":"Island Gold is officially sold out. Join the priority restock list for first access."},{"type":"url","id":"link","label":"Optional link"},{"type":"text","id":"icon","label":"Optional icon","default":"🔥"},{"type":"select","id":"tone","label":"Tone","options":[{"value":"default","label":"Default"},{"value":"accent","label":"Highlight"}],"default":"default"}],"presets":[{"name":"BK Announcement Bar"}]}
{% endschema %}
