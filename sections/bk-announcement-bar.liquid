{% liquid
  assign announcement_link = section.settings.link
  if section.settings.product != blank
    assign announcement_link = section.settings.product.url
  endif
%}
<section class="bk-section bk-announcement-bar{% if section.settings.tone == 'accent' %} bk-announcement-bar--accent{% endif %}">
  <div class="bk-wrap bk-announcement-bar__inner">
    {% if announcement_link != blank %}
      <a href="{{ announcement_link }}">
        {% if section.settings.icon != blank %}<span class="bk-announcement-icon">{{ section.settings.icon }}</span>{% endif %}
        <span>{% if section.settings.product != blank and section.settings.product.available == false %}{{ section.settings.unavailable_text | escape }}{% else %}{{ section.settings.text | escape }}{% endif %}</span>
      </a>
    {% else %}
      {% if section.settings.icon != blank %}<span class="bk-announcement-icon">{{ section.settings.icon }}</span>{% endif %}
      <span>{% if section.settings.product != blank and section.settings.product.available == false %}{{ section.settings.unavailable_text | escape }}{% else %}{{ section.settings.text | escape }}{% endif %}</span>
    {% endif %}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .bk-announcement-bar {
    background: #050505;
    color: #ffb900;
    text-align: center;
    padding: 10px 16px;
    border-bottom: 4px solid #050505;
    font-size: clamp(16px, 2vw, 24px);
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: .04em;
  }
  #shopify-section-{{ section.id }} .bk-announcement-bar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .bk-announcement-bar a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .bk-announcement-icon {
    display: inline-flex;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .bk-announcement-bar--accent {
    background: linear-gradient(90deg, #ffb900, #ffd050);
    color: #050505;
  }
</style>


{% schema %}
{
  "name": "BK Announcement Bar",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "Island Gold is back. Bring Caribbean flavor to your kitchen."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Optional link"
    },
    {
      "type": "text",
      "id": "icon",
      "label": "Optional icon",
      "default": "\ud83d\udd25"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Tone",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "accent",
          "label": "Highlight"
        }
      ],
      "default": "default"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Availability product"
    },
    {
      "type": "text",
      "id": "unavailable_text",
      "label": "Unavailable message",
      "default": "Explore Island Gold and find your next favorite flavor."
    }
  ],
  "presets": [
    {
      "name": "BK Announcement Bar"
    }
  ]
}
{% endschema %}
