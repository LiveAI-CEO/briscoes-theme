{% liquid
  assign product_ref = section.settings.product
  assign active_variant = product_ref.selected_or_first_available_variant
  assign form_id = 'IslandGold-' | append: section.id
%}
<section id="IslandGoldSection-{{ section.id }}" class="bk-section bk-purchase" aria-labelledby="{{ form_id }}-title">
<div class="bk-wrap bk-purchase__grid">
  <div class="bk-purchase__media">{% if product_ref.featured_image != blank %}{{ product_ref.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360, 600, 900, 1200', sizes: '(min-width: 800px) 50vw, 100vw', alt: product_ref.title }}{% endif %}</div>
  <div class="bk-purchase__copy">
    <p class="bk-kicker">{{ section.settings.kicker | escape }}</p>
    <h2 id="{{ form_id }}-title" class="bk-title">{{ product_ref.title | default: section.settings.heading | escape }}</h2>
    <p class="bk-body">{{ section.settings.body | escape }}</p>
    {% if product_ref != blank %}
    <bk-island-purchase>
      <p class="bk-purchase__price" data-price aria-live="polite">{{ active_variant.price | money }}</p>
      {% form 'product', product_ref, id: form_id %}
        {{ form.errors | default_errors }}
        <label for="{{ form_id }}-variant">{{ 'bk.purchase.option' | t }}</label>
        <select id="{{ form_id }}-variant" name="id" required data-variant>
        {% for variant in product_ref.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" data-available="{{ variant.available }}" data-min="{{ variant.quantity_rule.min }}" data-step="{{ variant.quantity_rule.increment }}" data-max="{{ variant.quantity_rule.max }}"{% if variant.id == active_variant.id %} selected{% endif %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — {{ 'bk.purchase.sold_out' | t }}{% endunless %}</option>{% endfor %}
        </select>
        <label for="{{ form_id }}-quantity">{{ 'bk.purchase.quantity' | t }}</label>
        <input id="{{ form_id }}-quantity" name="quantity" type="number" inputmode="numeric" min="{{ active_variant.quantity_rule.min }}" step="{{ active_variant.quantity_rule.increment }}"{% if active_variant.quantity_rule.max != blank %} max="{{ active_variant.quantity_rule.max }}"{% endif %} value="{{ active_variant.quantity_rule.min }}" required data-quantity>
        <button type="submit" class="bk-btn" data-add data-available-label="{{ section.settings.cta_label | escape }}" data-unavailable-label="{{ 'bk.purchase.sold_out' | t | escape }}"{% unless active_variant.available %} disabled{% endunless %}>{% if active_variant.available %}{{ section.settings.cta_label | escape }}{% else %}{{ 'bk.purchase.sold_out' | t }}{% endif %}</button>
      {% endform %}
      <a href="{{ product_ref.url }}">{{ 'bk.purchase.details' | t }}</a>
    </bk-island-purchase>
    {% elsif request.design_mode %}<p>{{ 'bk.purchase.choose_product' | t }}</p>{% endif %}
  </div>
</div>
</section>



{% schema %}
{
  "name": "Island Gold Featured",
  "tag": "section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Featured product"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow",
      "default": "Bring Caribbean flavor home"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Fallback heading",
      "default": "Island Gold All-Purpose Seasoning"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Description",
      "default": "Bring Chef Briscoe\u2019s Island Gold All-Purpose Seasoning to your kitchen."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Purchase button",
      "default": "Add to cart"
    }
  ],
  "presets": [
    {
      "name": "Island Gold Featured"
    }
  ]
}
{% endschema %}
