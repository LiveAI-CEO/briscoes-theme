<section class="bk-section bk-featured-product" style="background:#f7f2e8;color:#111;padding:58px 0;border-top:6px solid #050505;">
  <div class="bk-wrap bk-featured-grid">
    <div class="bk-product-media">
      {% assign product_ref = section.settings.product %}
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.heading }}
      {% elsif product_ref != blank and product_ref.featured_image != blank %}
        {{ product_ref.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: product_ref.title }}
      {% else %}
        <div class="bk-mark" style="width:120px;height:120px;font-size:42px;">IG</div>
      {% endif %}
    </div>
    <div class="bk-featured-copy">
      {% if section.settings.status_badge != blank %}<div class="bk-status-pill">{{ section.settings.status_badge }}</div>{% endif %}
      <p class="bk-kicker" style="color:#007a3d;">{{ section.settings.kicker }}</p>
      <h2 class="bk-product-title">{% if product_ref != blank %}{{ product_ref.title }}{% else %}{{ section.settings.heading }}{% endif %}</h2>
      <div class="bk-product-sub">{{ section.settings.subtitle }}</div>
      <p class="bk-body">{{ section.settings.body }}</p>
      <div class="bk-soldout-card">
        <h3>{{ section.settings.notice_heading }}</h3>
        <p>{{ section.settings.notice_text }}</p>
        <div class="bk-actions">
          {% if section.settings.cta_url != blank %}<a class="bk-btn" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>{% endif %}
          {% if section.settings.secondary_cta_url != blank %}<a class="bk-btn bk-btn--green" href="{{ section.settings.secondary_cta_url }}">{{ section.settings.secondary_cta_label }}</a>{% endif %}
        </div>
      </div>
      {% if section.settings.shipping_note != blank %}<p class="bk-body" style="margin-top:14px;color:#007a3d;">{{ section.settings.shipping_note }}</p>{% endif %}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .bk-featured-grid{display:grid;grid-template-columns:minmax(320px,.95fr) minmax(320px,1fr);gap:36px;align-items:start;}
  #shopify-section-{{ section.id }} .bk-product-media{min-height:440px;display:grid;place-items:center;border:4px solid #050505;border-radius:10px;background:radial-gradient(circle at 30% 35%,rgba(255,203,5,.4),transparent 24%),linear-gradient(34deg,transparent 0 43%,#ffb900 43% 48%,transparent 48% 52%,#ffb900 52% 57%,transparent 57%),#f5e6be;overflow:hidden;}
  #shopify-section-{{ section.id }} .bk-product-media img{width:100%;height:100%;object-fit:cover;display:block;}
  #shopify-section-{{ section.id }} .bk-product-title{margin-top:4px;color:#050505;font-size:clamp(50px,5.6vw,82px);line-height:.82;text-transform:uppercase;text-shadow:0 3px 0 rgba(255,203,5,.55);}
  #shopify-section-{{ section.id }} .bk-product-sub{color:#007a3d;font-family:Georgia,"Times New Roman",serif;font-style:italic;font-size:clamp(26px,3vw,40px);line-height:1;font-weight:900;}
  #shopify-section-{{ section.id }} .bk-status-pill{display:inline-flex;width:fit-content;padding:8px 12px;border:3px solid #050505;border-radius:999px;background:#ffb900;color:#050505;font-size:14px;line-height:1;text-transform:uppercase;letter-spacing:.08em;margin-bottom:12px;}
  #shopify-section-{{ section.id }} .bk-soldout-card{margin-top:20px;padding:20px;border:4px solid #050505;border-radius:16px;background:#fffdf8;box-shadow:0 6px 0 rgba(0,0,0,.2);}
  #shopify-section-{{ section.id }} .bk-soldout-card h3{margin:0 0 10px;color:#050505;font-size:clamp(24px,2.8vw,34px);line-height:1;text-transform:uppercase;}
  #shopify-section-{{ section.id }} .bk-soldout-card p{color:#111;font-family:Arial,sans-serif;font-size:16px;line-height:1.3;font-weight:900;}
  @media(max-width:990px){#shopify-section-{{ section.id }} .bk-featured-grid{grid-template-columns:1fr;}}
</style>

{% schema %}
{"name":"BK Featured Product","tag":"section","settings":[{"type":"product","id":"product","label":"Featured product"},{"type":"image_picker","id":"image","label":"Image override"},{"type":"text","id":"kicker","label":"Kicker","default":"Island Gold Sold Out — Again"},{"type":"text","id":"heading","label":"Fallback heading","default":"Island Gold All-Purpose Seasoning"},{"type":"text","id":"subtitle","label":"Subtitle","default":"Small-batch release. Priority access now open."},{"type":"text","id":"status_badge","label":"Status badge","default":"Priority restock list"},{"type":"textarea","id":"body","label":"Body","default":"The seasoning that started the movement is currently sold out. Join Chef Briscoe's priority list and be the first to know when the next small-batch release drops."},{"type":"text","id":"notice_heading","label":"Notice heading","default":"Island Gold Sold Out — Again"},{"type":"textarea","id":"notice_text","label":"Notice text","default":"The seasoning that started the movement is currently sold out. Join Chef Briscoe's priority list and be the first to know when the next small-batch release drops."},{"type":"text","id":"cta_label","label":"Primary CTA label","default":"Notify Me First"},{"type":"url","id":"cta_url","label":"Primary CTA URL"},{"type":"text","id":"secondary_cta_label","label":"Secondary CTA label","default":"Explore Recipes"},{"type":"url","id":"secondary_cta_url","label":"Secondary CTA URL"},{"type":"textarea","id":"shipping_note","label":"Shipping note","default":"Small-batch drops, chef-led updates, and one-pot family recipes first."}],"presets":[{"name":"BK Featured Product"}]}
{% endschema %}
