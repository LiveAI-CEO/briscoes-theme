<section class="bk-section bk-product-shop-header">
  <div class="bk-wrap bk-header-inner">
    <a class="bk-logo" href="{{ routes.root_url }}">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 360 | image_tag: loading: 'eager', alt: section.settings.brand_name }}
      {% else %}
        <span class="bk-mark">{{ section.settings.logo_mark }}</span><span>{{ section.settings.brand_name }}</span>
      {% endif %}
    </a>
    <nav class="bk-header-links" aria-label="Product shop navigation">
      {% if section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
      {% else %}
        {% if section.settings.shop_url != blank %}<a href="{{ section.settings.shop_url }}">{{ section.settings.shop_label }}</a>{% endif %}
        {% if section.settings.seasonings_url != blank %}<a href="{{ section.settings.seasonings_url }}">{{ section.settings.seasonings_label }}</a>{% endif %}
        {% if section.settings.recipe_cards_url != blank %}<a href="{{ section.settings.recipe_cards_url }}">{{ section.settings.recipe_cards_label }}</a>{% endif %}
        {% if section.settings.cookbooks_url != blank %}<a href="{{ section.settings.cookbooks_url }}">{{ section.settings.cookbooks_label }}</a>{% endif %}
        {% if section.settings.gift_sets_url != blank %}<a href="{{ section.settings.gift_sets_url }}">{{ section.settings.gift_sets_label }}</a>{% endif %}
        {% if section.settings.lifestyle_url != blank %}<a href="{{ section.settings.lifestyle_url }}">{{ section.settings.lifestyle_label }}</a>{% endif %}
        {% if section.settings.recipes_url != blank %}<a href="{{ section.settings.recipes_url }}">{{ section.settings.recipes_label }}</a>{% endif %}
        {% if section.settings.chef_url != blank %}<a href="{{ section.settings.chef_url }}">{{ section.settings.chef_label }}</a>{% endif %}
        {% if section.settings.private_dining_url != blank %}<a href="{{ section.settings.private_dining_url }}">{{ section.settings.private_dining_label }}</a>{% endif %}
        {% if section.settings.catering_url != blank %}<a href="{{ section.settings.catering_url }}">{{ section.settings.catering_label }}</a>{% endif %}
        {% if section.settings.wholesale_url != blank %}<a href="{{ section.settings.wholesale_url }}">{{ section.settings.wholesale_label }}</a>{% endif %}
        {% if section.settings.join_url != blank %}<a href="{{ section.settings.join_url }}">{{ section.settings.join_label }}</a>{% endif %}
      {% endif %}
    </nav>
    {% if section.settings.show_cart %}<a class="bk-header-cart" href="{{ routes.cart_url }}">Cart</a>{% endif %}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .bk-product-shop-header{background:linear-gradient(180deg,#00a352,#007a3d);border-bottom:4px solid #050505;}
  #shopify-section-{{ section.id }} .bk-header-inner{min-height:68px;display:flex;align-items:center;justify-content:space-between;gap:18px;}
  #shopify-section-{{ section.id }} .bk-header-links{display:flex;align-items:center;flex-wrap:wrap;justify-content:flex-end;gap:clamp(10px,1.2vw,16px);font-size:clamp(13px,1vw,15px);line-height:1;}
  #shopify-section-{{ section.id }} .bk-header-links a{color:#ffd050;text-decoration:none;text-transform:uppercase;text-shadow:2px 2px 0 rgba(0,0,0,.5);white-space:nowrap;}
  #shopify-section-{{ section.id }} .bk-header-cart{min-width:74px;min-height:44px;display:grid;place-items:center;border:3px solid #050505;border-radius:999px;background:#ffb900;color:#050505;text-decoration:none;text-transform:uppercase;box-shadow:0 4px 0 rgba(0,0,0,.55);}
  @media(max-width:760px){#shopify-section-{{ section.id }} .bk-header-inner{flex-direction:column;align-items:flex-start;}#shopify-section-{{ section.id }} .bk-header-links{width:100%;justify-content:flex-start;overflow-x:auto;padding-bottom:4px;}#shopify-section-{{ section.id }} .bk-header-cart{align-self:flex-end;}}
</style>

{% schema %}
{"name":"BK Product Shop Header","tag":"section","settings":[{"type":"image_picker","id":"logo","label":"Logo image"},{"type":"text","id":"brand_name","label":"Fallback brand name","default":"Briscoe's Kitchen & Spice"},{"type":"text","id":"logo_mark","label":"Fallback logo mark","default":"B"},{"type":"link_list","id":"menu","label":"Navigation menu"},{"type":"checkbox","id":"show_cart","label":"Show cart","default":true},{"type":"text","id":"shop_label","label":"Shop label","default":"Shop"},{"type":"url","id":"shop_url","label":"Shop URL"},{"type":"text","id":"seasonings_label","label":"Seasonings label","default":"Seasonings"},{"type":"url","id":"seasonings_url","label":"Seasonings URL"},{"type":"text","id":"recipe_cards_label","label":"Recipe cards label","default":"Recipe Cards"},{"type":"url","id":"recipe_cards_url","label":"Recipe cards URL"},{"type":"text","id":"cookbooks_label","label":"Cookbooks label","default":"Cookbooks"},{"type":"url","id":"cookbooks_url","label":"Cookbooks URL"},{"type":"text","id":"gift_sets_label","label":"Gift sets label","default":"Gift Sets"},{"type":"url","id":"gift_sets_url","label":"Gift sets URL"},{"type":"text","id":"lifestyle_label","label":"Briscoe lifestyle label","default":"Briscoe Lifestyle"},{"type":"url","id":"lifestyle_url","label":"Briscoe lifestyle URL"},{"type":"text","id":"recipes_label","label":"Recipes label","default":"Recipes"},{"type":"url","id":"recipes_url","label":"Recipes URL"},{"type":"text","id":"chef_label","label":"Meet Chef Briscoe label","default":"Meet Chef Briscoe"},{"type":"url","id":"chef_url","label":"Meet Chef Briscoe URL"},{"type":"text","id":"private_dining_label","label":"Private dining label","default":"Private Dining"},{"type":"url","id":"private_dining_url","label":"Private Dining URL"},{"type":"text","id":"catering_label","label":"Catering label","default":"Catering & Events"},{"type":"url","id":"catering_url","label":"Catering URL"},{"type":"text","id":"wholesale_label","label":"Wholesale label","default":"Wholesale"},{"type":"url","id":"wholesale_url","label":"Wholesale URL"},{"type":"text","id":"join_label","label":"Join label","default":"Join the One Pot Family"},{"type":"url","id":"join_url","label":"Join URL"}],"presets":[{"name":"BK Product Shop Header"}]}
{% endschema %}
